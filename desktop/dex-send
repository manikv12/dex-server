#!/usr/bin/env python3
"""dex-send: gives a file to the person (it shows as a file card in your chat with them).

    dex-send <file> ["a short note"]

A file outside your home folder is first copied to ~/Outbox/. Then the hub is asked over this
computer's own socket (~/.dex/files.sock): it checks the file, keeps a copy for the person's devices,
and answers with one line, printed here ("Sent to the person: ..." or "Not sent: ..."). Exit code 0 / 1.
Files in ~/Inbox and ~/Outbox are removed after 1 day; ~/Keep is never cleaned.
"""
import json, os, shutil, socket, sys

SOCK = os.path.expanduser("~/.dex/files.sock")
WAIT = 300                                     # seconds: the hub copies up to 500 MB


def free(folder, name):
    stem, ext = os.path.splitext(name)
    for n in range(1, 1000):
        path = os.path.join(folder, name if n == 1 else f"{stem} ({n}){ext}")
        if not os.path.lexists(path):
            return path
    raise OSError("no free name in ~/Outbox")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print('Usage: dex-send <file> ["a short note"]')
        return 1
    home = os.path.realpath(os.path.expanduser("~"))
    path = os.path.realpath(os.path.expanduser(sys.argv[1]))
    note = " ".join(sys.argv[2:])
    if not os.path.isfile(path):
        print("Not sent: no such file")
        return 1
    if os.path.commonpath([home, path]) != home:
        # The hub reaches only the home folder: a copy goes to ~/Outbox first.
        try:
            outbox = os.path.join(home, "Outbox")
            os.makedirs(outbox, exist_ok=True)
            copy = free(outbox, os.path.basename(path))
            shutil.copyfile(path, copy)
            path = copy
        except OSError as e:
            print(f"Not sent: could not copy it to ~/Outbox ({e.strerror or e})")
            return 1
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(WAIT)
        s.connect(SOCK)
        s.sendall(json.dumps({"op": "send", "path": os.path.relpath(path, home), "note": note}).encode() + b"\n")
        buf = b""
        while b"\n" not in buf:
            data = s.recv(65536)
            if not data:
                break
            buf += data
        s.close()
        reply = json.loads(buf.split(b"\n")[0])
    except (OSError, ValueError):
        print("Not sent: Dex could not be reached. Try again in a minute.")
        return 1
    print(reply.get("text") or ("Sent." if reply.get("ok") else "Not sent."))
    return 0 if reply.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
