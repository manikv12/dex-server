        raise Fail("Usage: dex-browser select <ref> <option text>")
    async with Session(st) as s:
        ref, info = await s.ref(args[0])
        r = await s.js("choose", st.get("doc"), ref, " ".join(args[1:]))
        if r.get("err") == "notselect":
            raise Fail(f"{ref} is not a plain list box. Click it, run snapshot, then click the option you want.")
        if r.get("err") == "nooption":
