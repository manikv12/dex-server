#!/usr/bin/env python3
"""dex-browser: drive the visible Chrome by element, over the Chrome DevTools Protocol.

Made for an AI agent calling it from a shell. Short plain-text output, one-line
errors, exit code 1 on failure. Talks to http://127.0.0.1:9222 (DEX_BROWSER_PORT
changes the port). Refs from `snapshot` are kept in ~/.dex/browser-state.json.

  dex-browser tabs | open <url> [--new-tab] | tab <index> | back | reload
  dex-browser snapshot [--all]
  dex-browser click <ref> | type <ref> <text> [--clear] [--enter] | select <ref> <option>
  dex-browser check <ref> on|off | focus <ref> | key <Enter|Tab|Escape|ArrowDown|Ctrl+A ...>
  dex-browser scroll up|down|top|bottom | text [--max N] | find <words>
  dex-browser wait [seconds | --for <text> [--timeout N]] | screenshot <file.png>

Pop-ups: an alert is closed with OK and its text is printed. A confirm/prompt/leave-page
question is answered Cancel unless the command has --accept-dialog (or --accept-dialog=<text>).
"""
import asyncio
import base64
import json
import os
import sys
import time
import urllib.error
import urllib.request

HOST = "127.0.0.1"
PORT = int(os.environ.get("DEX_BROWSER_PORT", "9222"))
STATE = os.path.expanduser(os.environ.get("DEX_BROWSER_STATE", "~/.dex/browser-state.json"))
SNAPSHOT_CAP = 120
ACCEPT_DIALOG = None  # set by --accept-dialog[=text]

# Chrome is on this machine: never send its traffic through a proxy.
for _k in ("http_proxy", "https_proxy", "all_proxy", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY"):
    os.environ.pop(_k, None)
os.environ["no_proxy"] = os.environ["NO_PROXY"] = "127.0.0.1,localhost"


class Fail(Exception):
    pass


class Timeout(Fail):
    pass


# ---------------------------------------------------------------- page script
