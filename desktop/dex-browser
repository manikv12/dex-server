        await s.send("Page.reload")
        await s.settle(0.5, limit=20)
        st.update(doc=None, refs={})
        await show_page(s, "reloaded")


async def snap(s, st):
    data = await s.js("collect", timeout=30)
    if data["doc"] != st.get("doc"):
        st["refs"] = {}
    st["doc"] = data["doc"]
    st["url"] = data["url"]
    refs = st.setdefault("refs", {})
    for it in data["items"]:
        refs[it["ref"]] = f'{it["role"]} {clip(it["name"], 40)}'
    return data


async def cmd_snapshot(st, args):
    show_all = "--all" in args
    async with Session(st) as s:
        d = await snap(s, st)
    print(f"page: {clip(d['title'], 100) or '(no title)'}")
    print(f"url: {d['url']}")
    screens = d["scrollH"] / d["vh"] if d["vh"] else 1
    if screens > 1.05:
        pct = round(100 * d["scrollY"] / max(1, d["scrollH"] - d["vh"]))
        print(f"scroll: {min(100, max(0, pct))}% down (page is {screens:.1f} screens tall)")
    items = d["items"] if show_all else [i for i in d["items"] if i["near"]]
    hidden = len(d["items"]) - len(items)
    cut = 0
    if not show_all and len(items) > SNAPSHOT_CAP:
        cut = len(items) - SNAPSHOT_CAP
        items = items[:SNAPSHOT_CAP]
    for it in items:
        print(line_for(it))
    if not d["items"]:
        print("(no clickable or typeable elements found)")
    for f in d["frames"]:
        if show_all or f["near"]:
            print(f"frame: cross-origin frame {clip(f['src'], 80) or '(no address)'} cannot be read; "
                  f"use the screenshot tool for what is inside it")
    if cut or hidden:
        print(f"({cut + hidden} more elements further up/down the page: scroll, "
              f"use `find <words>`, or `snapshot --all`)")


async def cmd_find(st, args):
    words = [w.lower() for w in " ".join(args).split()]
    if not words:
        raise Fail("Usage: dex-browser find <words>")
    async with Session(st) as s:
        d = await snap(s, st)
    hits = [it for it in d["items"]
            if all(w in " ".join([it["name"] or "", it["value"] or "", it["role"], *it["flags"]]).lower() for w in words)]
    for it in hits[:40]:
        print(line_for(it))
    if len(hits) > 40:
        print(f"({len(hits) - 40} more matches; use more words)")
    if not hits:
        print(f"no element matches \"{' '.join(words)}\" (try `dex-browser text` or a shorter word)")


async def cmd_click(st, args):
    if not args:
        raise Fail("Usage: dex-browser click <ref>")
    async with Session(st) as s:
        ref, info = await s.ref(args[0])
        before_tabs = {p["id"] for p in pages()}
        t0, u0 = await s.where()
        what = await s.click_ref(ref, info)
        print(f"clicked {what}" + (" (it looks disabled)" if info.get("disabled") else ""))
        await s.settle(0.5)
        new = [p for p in pages() if p["id"] not in before_tabs]
        if new:
