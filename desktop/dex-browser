# ---------------------------------------------------------------- helpers
def http(path, method="GET"):
    req = urllib.request.Request(f"http://{HOST}:{PORT}{path}", method=method)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=5) as r:
            body = r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        raise Fail(f"Chrome refused the request ({e.code}).")
    except (urllib.error.URLError, OSError):
        raise Fail(f"Chrome is not reachable on {HOST}:{PORT} (no debugging port). Start Chrome from the dock, "
                   f"or run `sudo dex-browser-enable`, then try again.")
    try:
        return json.loads(body)
    except ValueError:
        return body


def pages():
    return [t for t in http("/json/list") if t.get("type") == "page"
            and not t.get("url", "").startswith(("devtools://", "chrome-extension://"))]


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, STATE)


def clip(s, n=90):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[: n - 1] + "…"


def norm_ref(r):
    r = r.strip().strip("[]").lower()
    if r.startswith("ref="):
        r = r[4:]
    if r.isdigit():
        r = "e" + r
    if not (r.startswith("e") and r[1:].isdigit()):
        raise Fail(f"'{r}' is not a ref. Refs look like e12 (from `dex-browser snapshot`).")
    return r


def line_for(it):
    s = f"{it['ref']} {it['role']}"
    if it.get("name"):
        s += f' "{it["name"]}"'
    v = it.get("value")
    if v:
        s += " = [hidden]" if v == "[hidden]" else f' = "{v}"'
    if it.get("flags"):
        s += " (" + ", ".join(it["flags"]) + ")"
    return s


# ---------------------------------------------------------------- CDP session
class Session:
    def __init__(self, state):
        self.state = state
        self.ws = None
        self.n = 0
        self.events = []
        self.tab = None
        self.notes = []

    async def __aenter__(self):
        ps = pages()
        if not ps:
            http("/json/new?about:blank", "PUT")
            ps = pages()
        tab = next((p for p in ps if p["id"] == self.state.get("tab")), None) or ps[0]
        if tab["id"] != self.state.get("tab"):
            self.state.update(tab=tab["id"], doc=None, refs={})
        await self.attach(tab)
        return self

    async def attach(self, tab):
        if self.ws:
            await self.ws.close()
        import websockets
        url = tab.get("webSocketDebuggerUrl")
        if not url:
            raise Fail("That tab is already being controlled by another DevTools window; close DevTools and retry.")
        try:
            self.ws = await asyncio.wait_for(websockets.connect(url, max_size=None, ping_interval=None), 8)
        except Exception as e:
            raise Fail(f"Could not connect to the tab ({type(e).__name__}: {clip(str(e), 120)}).")
        self.tab = tab
        self.events = []
        try:
            # Chrome does not answer this while a pop-up dialog opened elsewhere is showing.
            await self.send("Page.enable", timeout=4)
        except Timeout:
            raise Fail("The page is not answering: a pop-up dialog (alert / confirm / leave page?) is probably "
                       "open. Use the screenshot tool to read it and press its button.")

    async def __aexit__(self, *a):
        for n in self.notes:
            print(n)
        if self.ws:
            try:
                await asyncio.wait_for(self.ws.close(), 2)
            except Exception:
                pass

    async def send(self, method, params=None, timeout=15):
        self.n += 1
        mid = self.n
        await self.ws.send(json.dumps({"id": mid, "method": method, "params": params or {}}))
        end = time.time() + timeout
        while True:
            left = end - time.time()
            if left <= 0:
                raise Timeout(f"Chrome did not answer in {timeout}s ({method}); the page may be frozen.")
            try:
                msg = json.loads(await asyncio.wait_for(self.ws.recv(), left))
            except asyncio.TimeoutError:
                continue
            except Exception as e:
                raise Fail(f"Lost the connection to the tab ({type(e).__name__}); the tab may have closed.")
            if msg.get("id") == mid:
                if "error" in msg:
                    raise Fail(f"{method} failed: {msg['error'].get('message')}")
                return msg.get("result", {})
            m = msg.get("method")
            if m:
                self.events.append(msg)
                if m == "Page.javascriptDialogOpening":
                    await self.answer_dialog(msg.get("params", {}))

    async def answer_dialog(self, p):
        # Answer at once on this connection: a dialog left open would freeze the page for later commands.
        kind, text = p.get("type", "dialog"), clip(p.get("message"), 160)
        accept = kind == "alert" or ACCEPT_DIALOG is not None
        prm = {"accept": accept}
        if accept and kind == "prompt" and ACCEPT_DIALOG:
            prm["promptText"] = ACCEPT_DIALOG
        self.n += 1
        await self.ws.send(json.dumps({"id": self.n, "method": "Page.handleJavaScriptDialog", "params": prm}))
        if kind == "alert":
            self.notes.append(f'the page showed an alert: "{text}" (closed with OK)')
        elif accept:
            self.notes.append(f'the page asked ({kind}): "{text}" -> answered OK')
        else:
            self.notes.append(f'the page asked ({kind}): "{text}" -> answered Cancel. '
                              f"To answer OK, run the same command again with --accept-dialog")

    async def js(self, fn, *args, timeout=15):
        expr = f"{JS.strip()}[{json.dumps(fn)}](...{json.dumps(list(args))})"
        r = await self.send("Runtime.evaluate", {"expression": expr, "returnByValue": True,
                                                 "awaitPromise": True}, timeout=timeout)
        if r.get("exceptionDetails"):
            ex = r["exceptionDetails"]
            raise Fail("Page script error: " + clip((ex.get("exception") or {}).get("description") or ex.get("text"), 160))
        return (r.get("result") or {}).get("value")

    async def eval(self, expr, timeout=5):
        r = await self.send("Runtime.evaluate", {"expression": expr, "returnByValue": True}, timeout=timeout)
        return (r.get("result") or {}).get("value")

    # ---- waiting for the page
    def _loading(self):
        fid = self.tab["id"]
        started = stopped = 0
        for e in self.events:
            p = e.get("params", {})
            if p.get("frameId") != fid:
                continue
            if e["method"] == "Page.frameStartedLoading":
                started += 1
            elif e["method"] == "Page.frameStoppedLoading":
                stopped += 1
        return started > stopped

    async def settle(self, first=0.4, limit=12):
        await asyncio.sleep(first)
        end = time.time() + limit
        t0 = time.time()
        while time.time() < end:
            try:
                rs = await self.eval("document.readyState", timeout=3)
            except Timeout:
                await asyncio.sleep(0.3)
                continue
            if not self._loading() and (rs == "complete" or (rs == "interactive" and time.time() - t0 > 3)):
                return
            await asyncio.sleep(0.25)

    async def where(self):
        return await self.eval("[document.title, location.href]") or ["", ""]

    # ---- refs
    async def ref(self, ref):
        ref = norm_ref(ref)
        if ref not in (self.state.get("refs") or {}):
            raise Fail(f"Ref {ref} is unknown (refs come from the last `dex-browser snapshot`). Run snapshot again.")
        info = await self.js("info", self.state.get("doc"), ref)
        if info.get("err") == "stale":
            raise Fail(f"Ref {ref} is stale (the page changed). Run `dex-browser snapshot` again.")
        return ref, info

    async def click_at(self, x, y, count=1):
        base = {"x": x, "y": y, "button": "left", "buttons": 0, "pointerType": "mouse"}
        await self.send("Input.dispatchMouseEvent", dict(base, type="mouseMoved", button="none"))
        await asyncio.sleep(0.05)
        for i in range(1, count + 1):
            await self.send("Input.dispatchMouseEvent", dict(base, type="mousePressed", buttons=1, clickCount=i))
            await asyncio.sleep(0.04)
            await self.send("Input.dispatchMouseEvent", dict(base, type="mouseReleased", clickCount=i))

    async def click_ref(self, ref, info):
        pt = await self.js("point", self.state.get("doc"), ref)
        err = pt.get("err")
        what = f'{ref} {info["role"]} "{clip(info["name"], 50)}"'
        if err == "stale":
            raise Fail(f"Ref {ref} is stale (the page changed). Run `dex-browser snapshot` again.")
        if err == "covered":
            raise Fail(f"{what} is covered by {pt['by']}. Close that first (snapshot to find it), or scroll.")
        if err == "invisible":
            raise Fail(f"{what} is not visible on the page right now.")
        if err == "offscreen":
            raise Fail(f"{what} could not be scrolled into view.")
        await asyncio.sleep(0.08)
        await self.click_at(pt["x"], pt["y"])
        return what

    async def key(self, spec):
        mods, key = parse_key(spec)
        k, code, vk, text = key
        if mods & 6:  # with Ctrl / Meta no text is typed
            text = None
        down = {"type": "keyDown" if text else "rawKeyDown", "key": k, "code": code,
                "windowsVirtualKeyCode": vk, "nativeVirtualKeyCode": vk, "modifiers": mods}
        if text:
            down.update(text=text, unmodifiedText=text)
        await self.send("Input.dispatchKeyEvent", down)
        await self.send("Input.dispatchKeyEvent", {"type": "keyUp", "key": k, "code": code,
                                                   "windowsVirtualKeyCode": vk, "nativeVirtualKeyCode": vk,
                                                   "modifiers": mods})


NAMED_KEYS = {
    "enter": ("Enter", "Enter", 13, "\r"), "return": ("Enter", "Enter", 13, "\r"),
    "tab": ("Tab", "Tab", 9, None), "escape": ("Escape", "Escape", 27, None), "esc": ("Escape", "Escape", 27, None),
    "backspace": ("Backspace", "Backspace", 8, None), "delete": ("Delete", "Delete", 46, None),
    "arrowup": ("ArrowUp", "ArrowUp", 38, None), "arrowdown": ("ArrowDown", "ArrowDown", 40, None),
    "arrowleft": ("ArrowLeft", "ArrowLeft", 37, None), "arrowright": ("ArrowRight", "ArrowRight", 39, None),
    "up": ("ArrowUp", "ArrowUp", 38, None), "down": ("ArrowDown", "ArrowDown", 40, None),
    "left": ("ArrowLeft", "ArrowLeft", 37, None), "right": ("ArrowRight", "ArrowRight", 39, None),
    "home": ("Home", "Home", 36, None), "end": ("End", "End", 35, None),
    "pageup": ("PageUp", "PageUp", 33, None), "pagedown": ("PageDown", "PageDown", 34, None),
    "space": (" ", "Space", 32, " "),
}
MODS = {"alt": 1, "option": 1, "ctrl": 2, "control": 2, "meta": 4, "cmd": 4, "command": 4, "shift": 8}


def parse_key(spec):
    parts = [p for p in spec.replace(" ", "").split("+") if p] or [spec]
    mods = 0
    for p in parts[:-1]:
        if p.lower() not in MODS:
            raise Fail(f"Unknown modifier '{p}'. Use Ctrl, Shift, Alt or Meta, like Ctrl+A.")
        mods |= MODS[p.lower()]
    last = parts[-1]
    if last.lower() in NAMED_KEYS:
        return mods, NAMED_KEYS[last.lower()]
    if len(last) == 1:
        c = last
        code = ("Key" + c.upper()) if c.isalpha() else ("Digit" + c) if c.isdigit() else ""
        if mods & 8 and c.isalpha():
            c = c.upper()
        return mods, (c, code, ord(c.upper()) if c.isalnum() else ord(c), c)
    m = __import__("re").fullmatch(r"[fF]([1-9]|1[0-2])", last)
    if m:
        n = int(m.group(1))
        return mods, (f"F{n}", f"F{n}", 111 + n, None)
    raise Fail(f"Unknown key '{last}'. Try Enter, Tab, Escape, Backspace, ArrowDown, PageDown, Space, or Ctrl+A.")


