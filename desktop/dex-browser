async def cmd_scroll(st, args):
    where = (args[0].lower() if args else "down")
    if where not in ("up", "down", "top", "bottom"):
        raise Fail("Usage: dex-browser scroll up|down|top|bottom")
    async with Session(st) as s:
        w = await s.js("where")
        x, y = w["vw"] / 2, w["vh"] / 2
        step = round(w["vh"] * 0.8)
        if where in ("top", "bottom"):
            await s.js("scrollTo", where)
            dy = (-1 if where == "top" else 1) * step * 5
        else:
            dy = (1 if where == "down" else -1) * step
        w1 = await s.js("where")
        if where in ("up", "down") or w1["y"] == w["y"]:
            # A real wheel turn over the middle of the page (it also scrolls inner panels).
            try:
                await s.send("Input.dispatchMouseEvent", {"type": "mouseWheel", "x": x, "y": y,
                                                          "deltaX": 0, "deltaY": dy}, timeout=2)
            except Timeout:
                pass  # Chrome answers wheel events late when the tab is not painting; the scroll still happens.
            await asyncio.sleep(0.4)
        w2 = await s.js("where")
        if where in ("up", "down") and w2["y"] == w["y"]:
            await s.eval(f"window.scrollBy(0, {dy})")
            w2 = await s.js("where")
        span = max(1, w2["h"] - w2["vh"])
        pct = min(100, max(0, round(100 * w2["y"] / span)))
        moved = "" if w2["y"] != w["y"] else " (the page itself did not move; it may be at the end, or an inner panel scrolled)"
        print(f"scrolled {where}; now {pct}% down the page{moved}")


async def cmd_text(st, args):
    mx = 6000
    if "--max" in args:
        try:
            mx = int(args[args.index("--max") + 1])
        except (IndexError, ValueError):
            raise Fail("Usage: dex-browser text [--max N]")
    async with Session(st) as s:
        t, u = await s.where()
        txt = await s.js("text", timeout=20) or ""
    lines, blank = [], 0
    for ln in txt.splitlines():
        ln = ln.rstrip()
        if not ln.strip():
            blank += 1
            if blank > 1:
                continue
        else:
            blank = 0
        lines.append(ln)
    out = "\n".join(lines).strip()
    print(f"page: {clip(t, 100)} | {u}")
    if len(out) > mx:
        print(out[:mx])
        print(f"... ({len(out) - mx} more characters; use --max {len(out)} or scroll + snapshot)")
    else:
        print(out or "(the page has no text)")


async def cmd_wait(st, args):
    if args and args[0] == "--for":
        if len(args) < 2:
            raise Fail("Usage: dex-browser wait --for <text> [--timeout N]")
        limit = 20.0
        a = args[1:]
        if "--timeout" in a:
            i = a.index("--timeout")
            try:
                limit = float(a[i + 1])
            except (IndexError, ValueError):
                raise Fail("Usage: dex-browser wait --for <text> [--timeout N]")
            a = a[:i] + a[i + 2:]
        want = " ".join(a)
        end = time.time() + limit
        async with Session(st) as s:
            while time.time() < end:
                try:
                    if await s.js("hasText", want, timeout=5):
                        print(f'found "{want}"')
                        return
                except Timeout:
                    pass
                await asyncio.sleep(0.5)
        raise Fail(f'"{want}" did not appear within {limit:g}s.')
    if args:
        try:
            n = float(args[0])
        except ValueError:
            raise Fail("Usage: dex-browser wait [seconds | --for <text>]")
        await asyncio.sleep(max(0, min(n, 120)))
        print(f"waited {n:g}s")
        return
    async with Session(st) as s:
        await s.settle(0.2, limit=20)
        await show_page(s, "ready")


async def cmd_screenshot(st, args):
    if not args:
        raise Fail("Usage: dex-browser screenshot <file.png>")
    path = os.path.abspath(os.path.expanduser(args[0]))
    async with Session(st) as s:
        r = await s.send("Page.captureScreenshot", {"format": "png"}, timeout=30)
    data = base64.b64decode(r["data"])
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "wb") as f:
        f.write(data)
    print(f"saved {path} ({len(data) // 1024} KB)")


COMMANDS = {
    "tabs": cmd_tabs, "open": cmd_open, "tab": cmd_tab, "back": cmd_back, "reload": cmd_reload,
    "snapshot": cmd_snapshot, "click": cmd_click, "type": cmd_type, "select": cmd_select,
    "check": cmd_check, "key": cmd_key, "scroll": cmd_scroll, "focus": cmd_focus, "text": cmd_text,
    "find": cmd_find, "wait": cmd_wait, "screenshot": cmd_screenshot,
}


def main():
    global ACCEPT_DIALOG
    argv = []
    for a in sys.argv[1:]:
        if a == "--accept-dialog" or a.startswith("--accept-dialog="):
            ACCEPT_DIALOG = a.partition("=")[2]
        else:
            argv.append(a)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    fn = COMMANDS.get(argv[0])
    if not fn:
        print(f"error: unknown command '{argv[0]}'. Run `dex-browser help`.")
        return 2
    st = load_state()
    try:
        asyncio.run(fn(st, argv[1:]))
        return 0
    except Fail as e:
        print(f"error: {e}")
        return 1
    except ImportError:
        print("error: the Python package 'websockets' is missing (apt install python3-websockets).")
        return 1
    except KeyboardInterrupt:
        return 130
    except Exception as e:  # never show a traceback to the agent
        print(f"error: {type(e).__name__}: {clip(str(e), 200)}")
        return 1
    finally:
        try:
            save_state(st)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
