            print(f"page changed: {clip(t1, 80)} | {u1}")


def refuse_secret(ref, info):
    kind = info["secret"]
    if kind == "card number":
        raise Fail(f"{ref} is a card number field: dex-browser will not type into it. "
                   f"Run `dex-browser focus {ref}` and ask the person to type it.")
    tool = "enter_code" if kind == "one-time code" else "fill_password"
    raise Fail(f"{ref} is a {kind} field: dex-browser will not type into it. Run `dex-browser focus {ref}`, "
               f"then use your {tool} tool.")


async def cmd_type(st, args):
    clear = "--clear" in args
    enter = "--enter" in args
    rest = [a for a in args if a not in ("--clear", "--enter")]
    if len(rest) < 2 and not (len(rest) == 1 and clear):
        raise Fail("Usage: dex-browser type <ref> <text> [--clear] [--enter]")
    text = " ".join(rest[1:])
    async with Session(st) as s:
        ref, info = await s.ref(rest[0])
        if info["secret"]:
            refuse_secret(ref, info)
        if not info["textual"]:
            raise Fail(f'{ref} is a {info["role"]}, not a text field. Use click, select or check instead.')
        if info.get("disabled"):
            raise Fail(f"{ref} is disabled.")
        target = ref
        foc = await s.js("isFocused", st.get("doc"), ref)
        if not foc.get("ok"):
            try:
                await s.click_ref(ref, info)
                await asyncio.sleep(0.2)
            except Fail as e:
                if "covered" in str(e):
                    raise
            foc = await s.js("focus", st.get("doc"), ref)
            if not foc.get("ok"):
                # Some sites swap the field for a new one when it is clicked: use the field that has the cursor.
                act = await s.js("active")
                if not act.get("editable"):
                    raise Fail(f"Could not put the cursor in {ref}; click it first, then try again.")
                if act.get("secret"):
                    refuse_secret(ref, dict(info, secret=act["secret"]))
                target = None
        c = await s.js("caret", st.get("doc"), target, clear)
        if not c.get("ok"):
            await s.key("Ctrl+A" if clear else "End")
        if clear and not text:
            await s.key("Backspace")
        if text:
            await s.send("Input.insertText", {"text": text})
        v = await s.js("value", st.get("doc"), target)
        shown = "" if v.get("value") is None else f' (now "{clip(v["value"], 60)}")'
        print(f'typed into {ref} {info["role"]} "{clip(info["name"], 50)}"{shown}')
        if enter:
            t0, u0 = await s.where()
            await s.key("Enter")
            await s.settle(0.6)
            t1, u1 = await s.where()
            print("pressed Enter" + (f"; page changed: {clip(t1, 80)} | {u1}" if u1 != u0 else ""))


async def cmd_focus(st, args):
    if not args:
        raise Fail("Usage: dex-browser focus <ref>")
    async with Session(st) as s:
        ref, info = await s.ref(args[0])
        try:
            await s.click_ref(ref, info)
            await asyncio.sleep(0.15)
        except Fail as e:
            if "covered" in str(e):
                raise
        r = await s.js("focus", st.get("doc"), ref)
        if not r.get("ok"):
            act = await s.js("active")  # the site may have swapped the field for a new one
            if not act.get("editable"):
                raise Fail(f"Could not put the cursor in {ref}.")
            info = dict(info, secret=act.get("secret") or info["secret"])
        msg = f'focused {ref} {info["role"]} "{clip(info["name"], 50)}"'
        if info["secret"] == "password":
            msg += ". Now use your fill_password tool."
        elif info["secret"] == "one-time code":
            msg += ". Now use your enter_code tool."
        elif info["secret"]:
            msg += ". Ask the person to type it."
        print(msg)


async def cmd_select(st, args):
