def fix_url(u):
    if "://" in u or u.startswith(("about:", "data:", "file:", "chrome:")):
        return u
    return "https://" + u


async def show_page(s, prefix="page"):
    t, u = await s.where()
    print(f"{prefix}: {clip(t, 80) or '(no title)'} | {u}")


async def cmd_open(st, args):
    new = "--new-tab" in args
    rest = [a for a in args if a != "--new-tab"]
    if not rest:
        raise Fail("Usage: dex-browser open <url> [--new-tab]")
    url = fix_url(rest[0])
    if new:
        from urllib.parse import quote
        tab = http("/json/new?" + quote(url, safe=":/?&=%#+@,;~"), "PUT")
        if not isinstance(tab, dict) or "id" not in tab:
            raise Fail("Chrome did not open a new tab.")
        http(f"/json/activate/{tab['id']}")
        st.update(tab=tab["id"], doc=None, refs={})
        async with Session(st) as s:
            await s.settle(0.6)
            await show_page(s, "opened in new tab")
        return
    async with Session(st) as s:
        http(f"/json/activate/{s.tab['id']}")
        r = await s.send("Page.navigate", {"url": url}, timeout=30)
        if r.get("errorText"):
            raise Fail(f"Could not open {url}: {r['errorText']}")
        await s.settle(0.5, limit=20)
        st.update(doc=None, refs={})
        await show_page(s, "opened")


async def cmd_tab(st, args):
    if not args or not args[0].isdigit():
        raise Fail("Usage: dex-browser tab <index>  (see `dex-browser tabs`)")
    i = int(args[0])
    ps = pages()
    ids = st.get("tabs") or [p["id"] for p in ps]
    if i >= len(ids):
        raise Fail(f"There is no tab {i}. Run `dex-browser tabs`.")
    tab = next((p for p in ps if p["id"] == ids[i]), None)
    if not tab:
        raise Fail(f"Tab {i} was closed. Run `dex-browser tabs` again.")
    http(f"/json/activate/{tab['id']}")
    st.update(tab=tab["id"], doc=None, refs={})
    print(f"now in tab {i}: {clip(tab.get('title'), 80)} | {tab.get('url')}")


async def cmd_back(st, args):
    async with Session(st) as s:
        h = await s.send("Page.getNavigationHistory")
        i = h.get("currentIndex", 0)
        if i <= 0:
            raise Fail("There is no earlier page in this tab.")
        await s.send("Page.navigateToHistoryEntry", {"entryId": h["entries"][i - 1]["id"]})
        await s.settle(0.5)
        st.update(doc=None, refs={})
        await show_page(s, "back to")


async def cmd_reload(st, args):
