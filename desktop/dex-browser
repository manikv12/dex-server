async def cmd_check(st, args):
    if len(args) < 2 or args[1].lower() not in ("on", "off"):
        raise Fail("Usage: dex-browser check <ref> on|off")
    want = args[1].lower() == "on"
    async with Session(st) as s:
        ref, info = await s.ref(args[0])
        if info["checked"] is None:
            raise Fail(f'{ref} {info["role"]} has no on/off state. Use click instead.')
        if info["checked"] == want:
